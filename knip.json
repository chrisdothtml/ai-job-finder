{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/{server,ui}/index.ts!",
    "src/.scripts/*.ts",
    "src/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["public", "src/**/*.d.ts"],
  "yarn": true,
  "ignoreExportsUsedInFile": true,
  "tags": ["-@knipignore"]
}
