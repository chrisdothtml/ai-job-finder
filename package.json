{
  "type": "module",
  "scripts": {
    "// checks": "----------------------------",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write .",
    "test": "./bin/tsn --experimental-test-module-mocks --test",
    "typecheck": "tsc -b --pretty",
    "// utils": "-----------------------------",
    "server:start": "./bin/tsn --env-file=.env ./src/server/index.ts",
    "// entrypoints": "-----------------------",
    "analyze": "./bin/tsn --env-file=.env ./src/.scripts/analyze.ts",
    "compare-models": "./bin/tsn --env-file=.env ./src/.scripts/compare-models.ts",
    "app:dev": "nodemon -w src/server -e ts -x 'yarn server:start'",
    "app:build": "./bin/tsn ./src/.scripts/esbuild.ts appBuild",
    "app:start": "NODE_ENV=production yarn server:start"
  },
  "volta": {
    "node": "25.2.1",
    "yarn": "4.13.0"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.5.0",
    "@opendocsg/pdf2md": "^0.2.7",
    "esbuild": "^0.28.0",
    "koa": "^3.2.0",
    "koa-static": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/koa": "^3.0.2",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0",
    "typescript": "^5.9.2"
  }
}
